rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed(){ return request.auth != null; }
    function uid(){ return request.auth.uid; }
    function admin(){ return signed() && exists(/databases/$(database)/documents/admins/$(uid())); }
    function me(){ return get(/databases/$(database)/documents/users/$(uid())).data; }
    function active(){ return signed() && !me().get('banned', false); }
    function subOk(){
      return get(/databases/$(database)/documents/config/site).data.subOn == false
          || me().get('paidUntil', 0) > request.time.toMillis();
    }

    match /admins/{id} { allow read: if signed() && uid() == id; }
    match /config/{id} { allow read: if true; allow write: if admin(); }

    match /users/{id} {
      allow read: if signed() && (uid() == id || admin());
      allow create: if uid() == id && request.resource.data.role in ['customer','owner']
                    && request.resource.data.banned == false
                    && !('paidUntil' in request.resource.data);
      allow update: if admin();
    }

    match /shops/{id} {
      allow read: if true;
      allow create: if active() && me().role == 'owner' && subOk()
                    && request.resource.data.ownerId == uid()
                    && request.resource.data.banned == false
                    && request.resource.data.paidUntil == me().get('paidUntil', 0);
      allow update: if admin() || (active() && resource.data.ownerId == uid()
                    && request.resource.data.ownerId == uid()
                    && request.resource.data.banned == resource.data.banned
                    && request.resource.data.paidUntil == resource.data.paidUntil);
      allow delete: if admin();
    }

    match /products/{id} {
      allow read: if true;
      allow create: if active() && request.resource.data.ownerId == uid();
      allow update, delete: if active() && resource.data.ownerId == uid();
    }

    match /orders/{id} {
      allow create: if active() && request.resource.data.cid == uid();
      allow read: if signed() && (resource.data.cid == uid() || resource.data.ownerId == uid());
      allow update: if active() && resource.data.ownerId == uid();
    }

    match /reviews/{id} { allow read: if true; allow create: if active() && request.resource.data.uid == uid(); }
    match /reports/{id} { allow create: if active() && request.resource.data.by == uid(); allow read: if admin(); }
    match /payments/{id} {
      allow create: if active() && request.resource.data.ownerId == uid();
      allow read: if signed() && (resource.data.ownerId == uid() || admin());
      allow update: if admin();
    }
  }
}
